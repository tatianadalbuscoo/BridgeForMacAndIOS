<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Flag that also flows through ProjectReference -->
		<UseTestStubs>true</UseTestStubs>
		<DefineConstants>$(DefineConstants);TEST_STUBS</DefineConstants>

		<!-- Keep auto-include of local .cs files enabled -->
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
		<PackageReference Include="xunit" Version="2.8.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
		<PackageReference Include="coverlet.collector" Version="6.0.2" />
	</ItemGroup>

	<!-- Sources under test (linked from Bridge project) -->
	<ItemGroup>
		<Compile Include="..\ShimmerAndroidBridge\Bridge\WsBridgeManager.cs" Link="UnderTest\WsBridgeManager.cs" />
		<Compile Include="..\ShimmerAndroidBridge\Bridge\ShimmerScanManager.cs" Link="UnderTest\ShimmerScanManager.cs" />
	</ItemGroup>

	<!-- Do NOT reference the real ShimmerAPI when using stubs -->
	<ItemGroup Condition="'$(UseTestStubs)'!='true'">
		<ProjectReference Include="..\ShimmerAPI\ShimmerAPI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="xunit.runner.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
