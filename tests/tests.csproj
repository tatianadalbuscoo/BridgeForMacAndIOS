<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Flag che “scorre” anche nei ProjectReference -->
		<UseTestStubs>true</UseTestStubs>
		<DefineConstants>$(DefineConstants);TEST_STUBS</DefineConstants>
		<!-- Lasciamo abilitato l'auto-include dei .cs locali -->
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
		<PackageReference Include="xunit" Version="2.8.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
		<PackageReference Include="coverlet.collector" Version="6.0.2" />
	</ItemGroup>

	<!-- Sorgenti sotto test (link dal progetto Bridge) -->
	<ItemGroup>
		<Compile Include="..\ShimmerAndroidBridge\Bridge\WsBridgeManager.cs" Link="UnderTest\WsBridgeManager.cs" />
		<Compile Include="..\ShimmerAndroidBridge\Bridge\ShimmerScanManager.cs" Link="UnderTest\ShimmerScanManager.cs" />
	</ItemGroup>

	<!-- NON referenziare la DLL reale ShimmerAPI quando usi gli stub -->
	<ItemGroup Condition="'$(UseTestStubs)'!='true'">
		<ProjectReference Include="..\ShimmerAPI\ShimmerAPI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="xunit.runner.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
