<?xml version="1.0" encoding="utf-8"?>

	<!-- 
	Shape drawable: rounded rectangle with surface fill, gray stroke, 
	and uniform 12dp padding. 
	-->

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
	<solid android:color="@color/surface"/>
	<stroke android:width="1dp" android:color="@color/gray200"/>
	<corners android:radius="16dp"/>
	<padding android:left="12dp" android:top="12dp"
			 android:right="12dp" android:bottom="12dp"/>
</shape>
