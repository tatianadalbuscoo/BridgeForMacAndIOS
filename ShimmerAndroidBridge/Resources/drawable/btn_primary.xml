<?xml version="1.0" encoding="utf-8"?>

	<!-- 
	Ripple drawable: rounded rectangle with caramel background and padding, 
	showing a light caramel ripple effect on press. 
	-->

<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/caramelLight">
	<item>
		<shape android:shape="rectangle">
			<corners android:radius="16dp"/>
			<solid android:color="@color/caramel"/>
			<padding android:left="18dp" android:top="12dp"
					 android:right="18dp" android:bottom="12dp"/>
		</shape>
	</item>
</ripple>
