<?xml version="1.0" encoding="utf-8"?>

	<!--
	App color palette: soft beige + caramel theme.
	Background/surface for pages and cards, warm browns for text,
	and caramel tones for primary actions and ripples.
	-->

<resources>
	
	<!-- App background (page backdrop) -->
	<color name="bg">#FAF1E6</color>

	<!-- Card/container surface -->
	<color name="surface">#FFFEFC</color>

	<!-- Primary text (warm brown) -->
	<color name="text">#7B4F2C</color>

	<!-- Secondary/muted text -->
	<color name="textMuted">#9A6C47</color>

	<!-- Primary brand (buttons/accents) -->
	<color name="caramel">#C3743B</color>

	<!-- Darker caramel (pressed / status bar) -->
	<color name="caramelDark">#A66131</color>

	<!-- Light caramel (highlights / ripple) -->
	<color name="caramelLight">#E7B085</color>

	<!-- Soft border color (card outlines) -->
	<color name="gray200">#EDE3D6</color>

	<!-- Soft ripple/hover tone -->
	<color name="gray300">#E5D6C5</color>

	<!-- Utility white -->
	<color name="white">#FFFFFF</color>
</resources>
